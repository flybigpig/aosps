{
    // 关闭 C/C++ 代码错误检查（最关键）
    "C_Cpp.errorSquiggles": "Disabled",
    
    // 关闭智能提示语法检查
    "C_Cpp.intelliSenseEngine": "Disabled",

    // 关闭所有语法校验装饰
    "problems.decorations.enabled": false,
    
    // 关闭文件保存时检查
    "editor.codeActionsOnSave": {
        "source.fixAll": "never"
    },

    // 关闭 C/C++ 非活动区域变暗
    "C_Cpp.dimInactiveRegions": false,

    // 禁用 C/C++ 扩展诊断功能
    "C_Cpp.codeAnalysis.runAutomatically": false,

    // 禁用 clangd 扩展的所有诊断（波浪线来源）
    "clangd.diagnostics.suppress": ["*"],
    "clangd.arguments": [
        "--suppress-diagnostics=*",
        "--background-index=false",
        "--clang-tidy=false",
        "--completion-style=bundled",
        "--header-insertion=never",
        "--all-scopes-completion=true"
    ],
    "clangd.fallbackFlags": [
        "-w",
        "-Wno-everything",
        "-fsyntax-only"
    ],
    "clangd.detectExtensionConflicts": true,

    // C/C++ 语言级别诊断关闭
    "[c]": {
        "editor.problemMatcher": [],
        "editor.showUnused": false,
        "editor.diagnosticSeverityOverrides": {}
    },
    "[cpp]": {
        "editor.problemMatcher": [],
        "editor.showUnused": false,
        "editor.diagnosticSeverityOverrides": {}
    },

    // 关闭 C/C++ 自动包含
    "C_Cpp.autoAddFileAssociations": false,

    // ========== 编辑器外观设置 ==========

    // 自动换行：off(不换行) / on(换行) / wordWrapColumn / bounded
    "editor.wordWrap": "off",

    // 显示行号：on(普通) / relative(相对) / interval(间隔) / off
    "editor.lineNumbers": "on",

    // 小地图(Minimap)：显示在编辑器右侧的代码缩略图
    "editor.minimap.enabled": true,
    "editor.minimap.side": "right",
    "editor.minimap.renderCharacters": true,
    "editor.minimap.maxColumn": 120,
    "editor.minimap.showSlider": "always",

    // 字体设置
    "editor.fontSize": 14,
    "editor.fontFamily": "Consolas, 'Courier New', monospace",
    "editor.fontLigatures": false,

    // 缩进设置
    "editor.tabSize": 4,
    "editor.insertSpaces": true,
    "editor.detectIndentation": true,

    // 空白字符渲染：none / boundary / selection / trailing / all
    "editor.renderWhitespace": "selection",

    // 缩进参考线
    "editor.guides.indentation": true,

    // 光标样式：line / block / underline | line / block / underline
    "editor.cursorStyle": "line",
    "editor.cursorBlinking": "smooth",

    // 滚动条设置
    "editor.scrollbar.vertical": "visible",
    "editor.scrollbar.horizontal": "visible",
    "editor.scrollbar.verticalScrollbarSize": 14,
    "editor.scrollbar.horizontalScrollbarSize": 14,

    // 括号对着色
    "editor.bracketPairColorization.enabled": true,
    "editor.guides.bracketPairs": "active",

    // 平滑滚动
    "editor.smoothScrolling": true,
    "editor.cursorSmoothCaretAnimation": "on",

    // 面包屑导航
    "breadcrumbs.enabled": true,

    // 粘性滚动（sticky scroll）
    "editor.stickyScroll.enabled": true,

    // ========== 搜索视图设置 ==========
    "search.actionsPosition": "auto",
    "search.alwaysOpenEditor": true,
    "search.autoFocus": true,
    "search.autoFocusScore": true,

    // 搜索视图显示在底部面板（中间位置），而非侧边栏
    "search.locationMode": "panel",

    // 搜索时自动打开搜索视图
    "search.openDefaultOnSearch": true,

    // 搜索结果显示为固定编辑器（不会被其他文件覆盖）
    "search.useEditorAsReplace": false,

    // 搜索时保持焦点在搜索框
    "search.focusDefaultOnSearch": true,

    // 输入时自动搜索（防抖延迟 300ms）
    "search.searchOnType": true,
    "search.searchOnTypeDebouncePeriod": 300,

    // 搜索结果保持展开状态
    "search.collapseResults": "auto",

    // 搜索时显示历史匹配项
    "search.quickOpen.includeHistory": true,

    // 排除的搜索文件/文件夹
    "search.exclude": {
        "**/out": true,
        "**/build": true,
        "**/.gradle": true,
        "**/node_modules": true,
        "**/dist": true
    },
    "clangd.inactiveRegions.useBackgroundHighlight": false,
    "clangd.enableCodeCompletion": true,
    "clangd.enable": true,
    "clangd.serverCompletionRanking": false
}